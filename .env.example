# ==============================================================================
# PulseEDU Global LMS — Environment Configuration
# ==============================================================================

# 1. Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/edu_lms?schema=public"

# 2. Application & WebSocket URLs
NEXT_PUBLIC_APP_URL="https://pulseedu.online"
NEXT_PUBLIC_WS_URL="wss://pulseedu.online/ws"
PORT=3000
HOSTNAME="0.0.0.0"

# 3. Authentication & Security
SESSION_SECRET="edupulse_academic_secure_session_secret_key_v1_2026"
STORAGE_DIR="./storage/uploads"

# 4. Default Seed Administrator
DEFAULT_ADMIN_EMAIL="admin@edupulse.uk"
DEFAULT_ADMIN_PASSWORD="AdminPass123!"
DEFAULT_ADMIN_NAME="System Admin"

# 5. Email Notifications (Resend API)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_REPLY_TO="support@pulseedu.online"

# 6. Payments.lk Gateway (https://payments.lk/developers)
# Sandbox key (sk_test_...) or live key (sk_live_...) from Payments.lk dashboard
PAYMENTS_LK_SECRET_KEY=""
PAYMENTS_LK_WEBHOOK_SECRET=""
PAYMENTS_LK_API_URL="https://api.payments.lk/v1"

# 7. Google Meet & Google Workspace API Integration
# Option A: Service Account with Domain-Wide Delegation (Recommended for automated recordings)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_IMPERSONATED_USER=""

# Option B: OAuth2 Refresh Token fallback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# 8. Platform Regional Settings
DEFAULT_TIMEZONE="Asia/Colombo"
