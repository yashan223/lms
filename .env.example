# ==============================================================================
# EduPulse Academy LMS — Production VPS Environment Configuration
# ==============================================================================

# PostgreSQL Connection (Docker or local VPS postgres)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/edu_lms?schema=public"

# Next.js Application Public URL (Your VPS Domain or Public IP)
NEXT_PUBLIC_APP_URL="https://lms.xoxod33p.tech"

# Optional WebSocket URL (defaults to wss://<domain>/ws or ws://<domain>/ws automatically)
# NEXT_PUBLIC_WS_URL="wss://lms.xoxod33p.tech/ws"

# Cryptographic Session & Token Signing Secret (Required for Production)
SESSION_SECRET="edupulse_academic_secure_session_secret_key_v1_2026"

# Server Port & Binding (Defaults to 3000 and 0.0.0.0)
PORT=3000
HOSTNAME="0.0.0.0"

# Local VPS Storage Directory for Uploads (Default: ./storage/uploads)
STORAGE_DIR="./storage/uploads"

# Default Initial Administrator Credentials
DEFAULT_ADMIN_EMAIL="admin@edupulse.uk"
DEFAULT_ADMIN_PASSWORD="AdminPass123!"
DEFAULT_ADMIN_NAME="Dr. Alastair Vance"

# Transactional Email Dispatch (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
