// Prisma Schema for PulseEDU Global (LMS)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TUTOR
  STUDENT
  INSTRUCTOR
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum EventType {
  LIVE_SEMINAR
  DEADLINE
  WORKSHOP
  EXAM_MOCK
  ASSIGNMENT
}

enum EventStatus {
  PENDING_APPROVAL
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
  REJECTED
}

enum TransactionType {
  PURCHASE
  SPEND
  REFUND
  BONUS
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(STUDENT)
  avatar        String?
  headline      String?
  bio           String?
  phone         String?
  country       String?
  academicLevel String?        @default("AL") // "OL" or "AL"
  emailVerified DateTime?      // Date & time student verified their email address
  publicKey     String?        // E2EE Public Key for client-side encryption
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Tutor relations
  createdCourses Course[]      @relation("TutorCourses")
  
  // Student relations
  enrollments    Enrollment[]
  progress       UserProgress[]
  reviews        Review[]
  certificates   Certificate[]
  privateFiles   PrivateFile[]
  badges         BadgeAward[]
  events         Event[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  tutorTrials    TrialRequest[] @relation("TutorTrials")
  studentTrials  TrialRequest[] @relation("StudentTrials")
  tokenWallet    TokenWallet?
  tutorAvailabilities TutorAvailability[] @relation("TutorAvailabilities")
  studentAvailabilities StudentAvailability[] @relation("StudentAvailabilities")

  // E2EE Chat Relations
  conversationsA Conversation[] @relation("ParticipantA")
  conversationsB Conversation[] @relation("ParticipantB")
  sentMessages   Message[]      @relation("SentMessages")
  receivedMessages Message[]    @relation("ReceivedMessages")

  // Notification Relations
  notifications  Notification[]
  payments       Payment[]

  @@map("users")
}

model TokenWallet {
  id           String             @id @default(cuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Float              @default(0) // Available tokens / hours
  transactions TokenTransaction[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("token_wallets")
}

model TokenTransaction {
  id          String          @id @default(cuid())
  walletId    String
  wallet      TokenWallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Float             // Positive for credit (+), negative for debit (-)
  type        TransactionType
  description String          // e.g., "Purchased 20 Hours Token Pack" or "1-on-1 Tutoring Session"
  referenceId String?         // Related eventId, trialId, or paymentId
  createdAt   DateTime        @default(now())

  @@map("token_transactions")
}

model TokenBundle {
  id          String   @id
  name        String
  hours       Int
  tokens      Int
  price       Float
  lkrPrice    Float      @default(0)
  olPrice     Float?
  olLkrPrice  Float?     @default(0)
  popular     Boolean  @default(false)
  badge       String   @default("Standard")
  description String
  roleTarget  String?
  ctaText     String?
  features    String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("token_bundles")
}

model Course {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  subtitle      String?
  description   String
  thumbnail     String?
  price         Float          @default(0.0)
  level         CourseLevel    @default(ADVANCED)
  category      String
  subjectCode   String?
  status        CourseStatus   @default(PUBLISHED)
  featured      Boolean        @default(false)
  tutorId       String
  tutor         User           @relation("TutorCourses", fields: [tutorId], references: [id], onDelete: Cascade)

  modules       Module[]
  materials     CourseMaterial[]
  enrollments   Enrollment[]
  reviews       Review[]
  certificates  Certificate[]
  events        Event[]
  trialRequests TrialRequest[]
  availabilities TutorAvailability[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("classes")
}

model Module {
  id          String    @id @default(cuid())
  title       String
  position    Int
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("modules")
}

model Lesson {
  id            String         @id @default(cuid())
  title         String
  description   String?
  videoUrl      String?
  durationMin   Int            @default(10)
  position      Int
  isFreePreview Boolean        @default(false)
  moduleId      String
  module        Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress      UserProgress[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("lessons")
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  @@unique([userId, courseId])
  @@map("enrollments")
}

model UserProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  isCompleted Boolean   @default(false)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@map("user_progress")
}

model Event {
  id              String      @id @default(cuid())
  title           String
  description     String?
  type            EventType   @default(LIVE_SEMINAR)
  status          EventStatus @default(SCHEDULED)
  meetingLink     String?
  startedAt       DateTime?
  endedAt         DateTime?
  dueDate         DateTime
  courseId        String?
  course          Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedBy     String?
  approvalStatus  String?     @default("APPROVED")
  rejectionReason String?
  createdAt       DateTime    @default(now())

  @@map("events")
}

model PrivateFile {
  id        String   @id @default(cuid())
  fileName  String
  fileSize  String
  fileType  String
  fileUrl   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("private_files")
}

model BadgeAward {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  awardedAt   DateTime @default(now())

  @@map("badge_awards")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      @default(5)
  comment   String?
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("reviews")
}

model Certificate {
  id              String    @id @default(cuid())
  certificateCode String    @unique
  userId          String
  courseId        String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  issuedAt        DateTime  @default(now())

  @@map("certificates")
}

model CourseMaterial {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  fileSize    String   @default("1.5 MB")
  fileType    String   @default("application/pdf")
  category    String   @default("HANDOUT") // "HANDOUT", "FORMULA_SHEET", "MOCK_PAPER", "LAB_GUIDE", "SLIDES"
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("class_materials")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("email_verification_tokens")
}

enum TrialStatus {
  PENDING
  PENDING_APPROVAL
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
}

model TrialRequest {
  id              String       @id @default(cuid())
  studentName     String
  studentEmail    String
  studentPhone    String?
  courseId        String?
  course          Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tutorId         String?
  tutor           User?        @relation("TutorTrials", fields: [tutorId], references: [id], onDelete: Cascade)
  studentId       String?
  student         User?        @relation("StudentTrials", fields: [studentId], references: [id], onDelete: Cascade)
  preferredDate   DateTime
  topic           String?
  status          TrialStatus  @default(PENDING)
  meetingLink     String?
  notes           String?
  approvalStatus  String?      @default("APPROVED")
  rejectionReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("trial_requests")
}

// ========================================================
// NOTIFICATIONS SYSTEM
// ========================================================
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // "INFO", "CLASS_LIVE", "CLASS_SCHEDULED", "CHAT_MESSAGE", "MATERIAL_ADDED", "TRIAL_UPDATE"
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ========================================================
// END-TO-END ENCRYPTED (E2EE) CHAT SYSTEM
// ========================================================
model Conversation {
  id             String    @id @default(cuid())
  participantAId String
  participantA   User      @relation("ParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantBId String
  participantB   User      @relation("ParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  courseId       String?
  lastMessageAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  messages       Message[]

  @@unique([participantAId, participantBId])
  @@index([participantAId])
  @@index([participantBId])
  @@map("conversations")
}

model Message {
  id               String       @id @default(cuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId       String
  receiver         User         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  encryptedContent String       // AES-GCM Ciphertext (Base64) - Zero Knowledge to Server
  iv               String       // AES-GCM Initialization Vector (Base64)
  senderPublicKey  String?      // Ephemeral / Session Key Identifier
  isRead           Boolean      @default(false)
  createdAt        DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([receiverId, isRead])
  @@map("messages")
}

// ========================================================
// TUTOR AVAILABILITY SYSTEM
// ========================================================
model TutorAvailability {
  id           String    @id @default(cuid())
  tutorId      String
  tutor        User      @relation("TutorAvailabilities", fields: [tutorId], references: [id], onDelete: Cascade)
  courseId     String?
  course       Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  dayOfWeek    Int?      // 0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat (for recurring weekly slots)
  specificDate DateTime? // For specific date slots
  startTime    String    // "HH:mm" e.g. "09:00", "14:30"
  endTime      String    // "HH:mm" e.g. "10:30", "16:00"
  slotType     String    @default("ALL") // "ALL", "CLASS", "TRIAL"
  isRecurring  Boolean   @default(false)
  isActive     Boolean   @default(true)
  title        String?   // Optional label e.g., "Morning Masterclass", "Evening 1-on-1"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tutorId])
  @@index([courseId])
  @@map("tutor_availabilities")
}

// ========================================================
// STUDENT AVAILABILITY / STUDY HOURS SYSTEM
// ========================================================
model StudentAvailability {
  id           String    @id @default(cuid())
  studentId    String
  student      User      @relation("StudentAvailabilities", fields: [studentId], references: [id], onDelete: Cascade)
  dayOfWeek    Int?      // 0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat (for weekly recurring study hours)
  specificDate DateTime? // For specific available dates
  startTime    String    // "HH:mm" e.g. "16:00"
  endTime      String    // "HH:mm" e.g. "20:00"
  isRecurring  Boolean   @default(true)
  isActive     Boolean   @default(true)
  title        String?   // Optional label e.g., "After-School Study Window", "Weekend Revision"
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([studentId])
  @@map("student_availabilities")
}
// ========================================================
// REALTIME EVENT LOG (Cross-process SSE)
// ========================================================
model SystemEvent {
  id        String   @id @default(cuid())
  type      String   // e.g. "TRIALS_CHANGED", "CHAT_MESSAGE", "NOTIFICATIONS_CHANGED"
  data      Json?    // optional payload (userId filter, classLive flag, etc.)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("system_events")
}

// ========================================================
// ADMIN AUDIT LOG — Full immutable history of all admin actions
// ========================================================
model AuditLog {
  id          String   @id @default(cuid())
  adminId     String                         // ID of the admin who performed the action
  adminEmail  String                         // Email snapshot at time of action
  action      String                         // e.g. "create_user", "delete_course", "approve_trial"
  category    String   @default("GENERAL")  // "USER", "COURSE", "CLASS", "TRIAL", "FINANCE", "PRICING", "GENERAL"
  targetId    String?                        // ID of the affected record (userId, courseId, eventId, etc.)
  targetLabel String?                        // Human-readable name/title of the affected record
  details     Json?                          // Extra context (before/after diff, reason, amount, etc.)
  ipAddress   String?                        // Admin's IP address
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@index([action])
  @@index([category])
  @@map("audit_logs")
}

// ========================================================
// PAYMENTS.LK GATEWAY TRANSACTIONS
// ========================================================
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
}

model Payment {
  id            String        @id @default(cuid())
  checkoutId    String?       @unique
  reference     String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents   Int           // e.g. 720000 = Rs. 7,200.00
  currency      String        @default("LKR")
  status        PaymentStatus @default(PENDING)
  itemType      String        // "TOKEN_BUNDLE" | "COURSE"
  itemId        String        // pack-6, pack-16, or courseId
  itemTitle     String        // Bundle or course name
  tokens        Int?          // Credit amount (if token bundle)
  checkoutUrl   String?
  paymentMethod String?
  rawWebhook    Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([reference])
  @@index([checkoutId])
  @@map("payments")
}
