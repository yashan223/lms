// Prisma Schema for EduPulse LMS (London A/L & O/L Academy)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum EventType {
  LIVE_SEMINAR
  DEADLINE
  WORKSHOP
  EXAM_MOCK
  ASSIGNMENT
}

enum EventStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(STUDENT)
  avatar        String?
  headline      String?
  bio           String?
  phone         String?
  publicKey     String?        // E2EE Public Key for client-side encryption
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Instructor relations
  createdCourses Course[]      @relation("InstructorCourses")
  
  // Student relations
  enrollments    Enrollment[]
  progress       UserProgress[]
  reviews        Review[]
  certificates   Certificate[]
  privateFiles   PrivateFile[]
  badges         BadgeAward[]
  events         Event[]
  passwordResetTokens PasswordResetToken[]
  tutorTrials    TrialRequest[] @relation("TutorTrials")
  studentTrials  TrialRequest[] @relation("StudentTrials")

  // E2EE Chat Relations
  conversationsA Conversation[] @relation("ParticipantA")
  conversationsB Conversation[] @relation("ParticipantB")
  sentMessages   Message[]      @relation("SentMessages")
  receivedMessages Message[]    @relation("ReceivedMessages")

  // Notification Relations
  notifications  Notification[]

  @@map("users")
}

model Course {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  subtitle      String?
  description   String
  thumbnail     String?
  price         Float          @default(0.0)
  level         CourseLevel    @default(ADVANCED)
  category      String
  subjectCode   String?
  status        CourseStatus   @default(PUBLISHED)
  featured      Boolean        @default(false)
  instructorId  String
  instructor    User           @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Cascade)

  modules       Module[]
  materials     CourseMaterial[]
  enrollments   Enrollment[]
  reviews       Review[]
  certificates  Certificate[]
  events        Event[]
  trialRequests TrialRequest[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("courses")
}

model Module {
  id          String    @id @default(cuid())
  title       String
  position    Int
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("modules")
}

model Lesson {
  id            String         @id @default(cuid())
  title         String
  description   String?
  videoUrl      String?
  durationMin   Int            @default(10)
  position      Int
  isFreePreview Boolean        @default(false)
  moduleId      String
  module        Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress      UserProgress[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("lessons")
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  @@unique([userId, courseId])
  @@map("enrollments")
}

model UserProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  isCompleted Boolean   @default(false)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@map("user_progress")
}

model Event {
  id          String      @id @default(cuid())
  title       String
  description String?
  type        EventType   @default(LIVE_SEMINAR)
  status      EventStatus @default(SCHEDULED)
  meetingLink String?
  startedAt   DateTime?
  endedAt     DateTime?
  dueDate     DateTime
  courseId    String?
  course      Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@map("events")
}

model PrivateFile {
  id        String   @id @default(cuid())
  fileName  String
  fileSize  String
  fileType  String
  fileUrl   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("private_files")
}

model BadgeAward {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  awardedAt   DateTime @default(now())

  @@map("badge_awards")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      @default(5)
  comment   String?
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("reviews")
}

model Certificate {
  id              String    @id @default(cuid())
  certificateCode String    @unique
  userId          String
  courseId        String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  issuedAt        DateTime  @default(now())

  @@map("certificates")
}

model CourseMaterial {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  fileSize    String   @default("1.5 MB")
  fileType    String   @default("application/pdf")
  category    String   @default("HANDOUT") // "HANDOUT", "FORMULA_SHEET", "MOCK_PAPER", "LAB_GUIDE", "SLIDES"
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("course_materials")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

enum TrialStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model TrialRequest {
  id              String       @id @default(cuid())
  studentName     String
  studentEmail    String
  studentPhone    String?
  courseId        String?
  course          Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tutorId         String?
  tutor           User?        @relation("TutorTrials", fields: [tutorId], references: [id], onDelete: Cascade)
  studentId       String?
  student         User?        @relation("StudentTrials", fields: [studentId], references: [id], onDelete: Cascade)
  preferredDate   DateTime
  topic           String?
  status          TrialStatus  @default(PENDING)
  meetingLink     String?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("trial_requests")
}

// ========================================================
// NOTIFICATIONS SYSTEM
// ========================================================
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // "INFO", "CLASS_LIVE", "CLASS_SCHEDULED", "CHAT_MESSAGE", "MATERIAL_ADDED", "TRIAL_UPDATE"
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ========================================================
// END-TO-END ENCRYPTED (E2EE) CHAT SYSTEM
// ========================================================
model Conversation {
  id             String    @id @default(cuid())
  participantAId String
  participantA   User      @relation("ParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantBId String
  participantB   User      @relation("ParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  courseId       String?
  lastMessageAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  messages       Message[]

  @@unique([participantAId, participantBId])
  @@index([participantAId])
  @@index([participantBId])
  @@map("conversations")
}

model Message {
  id               String       @id @default(cuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId       String
  receiver         User         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  encryptedContent String       // AES-GCM Ciphertext (Base64) - Zero Knowledge to Server
  iv               String       // AES-GCM Initialization Vector (Base64)
  senderPublicKey  String?      // Ephemeral / Session Key Identifier
  isRead           Boolean      @default(false)
  createdAt        DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([receiverId, isRead])
  @@map("messages")
}


