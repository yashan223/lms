
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TUTOR
  STUDENT
  INSTRUCTOR
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum EventType {
  LIVE_SEMINAR
  DEADLINE
  WORKSHOP
  EXAM_MOCK
  ASSIGNMENT
}

enum EventStatus {
  PENDING_APPROVAL
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
  REJECTED
}

enum TransactionType {
  PURCHASE
  SPEND
  REFUND
  BONUS
  ESCROW_LOCK
  ESCROW_RELEASE
}

model User {
  id            String         @id @default(cuid())
  studentId     String?        @unique
  tutorId       String?        @unique
  adminId       String?        @unique
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(STUDENT)
  avatar        String?
  headline      String?
  bio           String?
  phone         String?
  country       String?
  timezone      String?        @default("Asia/Colombo")
  academicLevel String?        @default("AL")
  emailVerified DateTime?
  publicKey     String?
  guardianName         String?
  guardianRelationship String?
  guardianPhone        String?
  igcsePayRate         Float?
  ialIasPayRate        Float?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  createdCourses Course[]      @relation("TutorCourses")
  
  enrollments    Enrollment[]
  progress       UserProgress[]
  reviews        Review[]
  certificates   Certificate[]
  privateFiles   PrivateFile[]
  badges         BadgeAward[]
  events         Event[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  tutorTrials    TrialRequest[] @relation("TutorTrials")
  studentTrials  TrialRequest[] @relation("StudentTrials")
  tokenWallet    TokenWallet?
  tutorAvailabilities TutorAvailability[] @relation("TutorAvailabilities")
  studentAvailabilities StudentAvailability[] @relation("StudentAvailabilities")
  studentEnrollmentRequests ClassEnrollmentRequest[] @relation("StudentEnrollmentRequests")
  tutorEnrollmentRequests   ClassEnrollmentRequest[] @relation("TutorEnrollmentRequests")
  studentRescheduleRequests ClassRescheduleRequest[] @relation("StudentRescheduleRequests")
  tutorRescheduleRequests   ClassRescheduleRequest[] @relation("TutorRescheduleRequests")
  tokenGrants TokenGrant[] @relation("UserTokenGrants")
  tutorEarnings TutorEarningRecord[] @relation("TutorEarnings")
  studentEarnings TutorEarningRecord[] @relation("StudentClassEarnings")
  tutorMonthlyPayouts TutorMonthlyPayoutArchive[] @relation("TutorMonthlyPayouts")

  conversationsA Conversation[] @relation("ParticipantA")
  conversationsB Conversation[] @relation("ParticipantB")
  sentMessages   Message[]      @relation("SentMessages")
  receivedMessages Message[]    @relation("ReceivedMessages")

  notifications  Notification[]
  payments       Payment[]
  attendanceRecords ClassAttendance[] @relation("UserAttendance")

  @@map("users")
}

model TokenWallet {
  id           String             @id @default(cuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Float              @default(0)
  frozenBalance Float             @default(0)
  transactions TokenTransaction[]
  grants       TokenGrant[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("token_wallets")
}

model TokenTransaction {
  id          String          @id @default(cuid())
  walletId    String
  wallet      TokenWallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Float
  type        TransactionType
  description String
  referenceId String?
  createdAt   DateTime        @default(now())

  @@map("token_transactions")
}

model TokenBundle {
  id          String   @id
  name        String
  hours       Int
  tokens      Int
  price       Float
  lkrPrice    Float      @default(0)
  olPrice     Float?
  olLkrPrice  Float?     @default(0)
  popular     Boolean  @default(false)
  badge       String   @default("Standard")
  description String
  roleTarget  String?
  ctaText     String?
  features    String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("token_bundles")
}

model Course {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  subtitle      String?
  description   String
  thumbnail     String?
  price         Float          @default(0.0)
  olPrice       Float?
  level         CourseLevel    @default(ADVANCED)
  category      String
  subjectCode   String?
  status        CourseStatus   @default(PUBLISHED)
  featured      Boolean        @default(false)
  tutorId       String
  tutor         User           @relation("TutorCourses", fields: [tutorId], references: [id], onDelete: Cascade)

  modules       Module[]
  materials     CourseMaterial[]
  enrollments   Enrollment[]
  reviews       Review[]
  certificates  Certificate[]
  events        Event[]
  trialRequests TrialRequest[]
  enrollmentRequests ClassEnrollmentRequest[]
  rescheduleRequests ClassRescheduleRequest[]
  earningRecords TutorEarningRecord[]
  availabilities TutorAvailability[]
  attendanceRecords ClassAttendance[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("classes")
}

model Module {
  id          String    @id @default(cuid())
  title       String
  position    Int
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("modules")
}

model Lesson {
  id            String         @id @default(cuid())
  title         String
  description   String?
  videoUrl      String?
  durationMin   Int            @default(10)
  position      Int
  isFreePreview Boolean        @default(false)
  moduleId      String
  module        Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress      UserProgress[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("lessons")
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  @@unique([userId, courseId])
  @@map("enrollments")
}

model UserProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  isCompleted Boolean   @default(false)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@map("user_progress")
}

model Event {
  id                 String      @id @default(cuid())
  classCode          String?     @unique
  title              String
  description        String?
  type               EventType   @default(LIVE_SEMINAR)
  status             EventStatus @default(SCHEDULED)
  meetingLink        String?
  meetingSpaceId     String?
  conferenceRecordId String?
  recordingUrl       String?
  recordingStatus    String?
  actualStartTime    DateTime?   @db.Timestamptz
  actualEndTime      DateTime?   @db.Timestamptz
  attendanceCount    Int?        @default(0)
  startedAt          DateTime?   @db.Timestamptz
  endedAt            DateTime?   @db.Timestamptz
  dueDate            DateTime    @db.Timestamptz
  timezone           String?     @default("Asia/Colombo")
  courseId           String?
  course             Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedBy        String?
  approvalStatus     String?     @default("APPROVED")
  rejectionReason    String?
  reminderSent       Boolean     @default(false)
  reminderSentAt     DateTime?   @db.Timestamptz
  tokenDeducted      Boolean     @default(false)
  tokenDeductedAt    DateTime?   @db.Timestamptz
  tutorJoinTimestamp DateTime?   @db.Timestamptz
  payoutTriggeredAt  DateTime?   @db.Timestamptz
  lockedPayoutAmount Float?
  academicLevel      String?
  earningRecord      TutorEarningRecord?
  enrollmentRequestId String?
  enrollmentRequest  ClassEnrollmentRequest? @relation(fields: [enrollmentRequestId], references: [id], onDelete: SetNull)
  rescheduleRequests ClassRescheduleRequest[]
  attendanceRecords  ClassAttendance[]
  createdAt          DateTime    @default(now()) @db.Timestamptz

  @@map("events")
}

model PrivateFile {
  id        String   @id @default(cuid())
  fileName  String
  fileSize  String
  fileType  String
  fileUrl   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("private_files")
}

model BadgeAward {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  awardedAt   DateTime @default(now())

  @@map("badge_awards")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      @default(5)
  comment   String?
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("reviews")
}

model Certificate {
  id              String    @id @default(cuid())
  certificateCode String    @unique
  userId          String
  courseId        String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  issuedAt        DateTime  @default(now())

  @@map("certificates")
}

model CourseMaterial {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  fileSize    String   @default("1.5 MB")
  fileType    String   @default("application/pdf")
  category    String   @default("HANDOUT")
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("class_materials")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("email_verification_tokens")
}

enum TrialStatus {
  PENDING
  PENDING_APPROVAL
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
}

model TrialRequest {
  id              String       @id @default(cuid())
  studentName     String
  studentEmail    String
  studentPhone    String?
  courseId        String?
  course          Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tutorId         String?
  tutor           User?        @relation("TutorTrials", fields: [tutorId], references: [id], onDelete: Cascade)
  studentId       String?
  student         User?        @relation("StudentTrials", fields: [studentId], references: [id], onDelete: Cascade)
  preferredDate   DateTime     @db.Timestamptz
  preferredDates  Json?
  topic           String?
  timezone        String?      @default("Asia/Colombo")
  status             TrialStatus  @default(PENDING)
  meetingLink        String?
  meetingSpaceId     String?
  conferenceRecordId String?
  recordingUrl       String?
  recordingStatus    String?
  actualStartTime    DateTime?    @db.Timestamptz
  actualEndTime      DateTime?    @db.Timestamptz
  notes              String?
  approvalStatus     String?      @default("APPROVED")
  rejectionReason    String?
  attendanceRecords  ClassAttendance[]
  createdAt          DateTime     @default(now()) @db.Timestamptz
  updatedAt          DateTime     @updatedAt @db.Timestamptz

  @@map("trial_requests")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model Conversation {
  id             String    @id @default(cuid())
  participantAId String
  participantA   User      @relation("ParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantBId String
  participantB   User      @relation("ParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  courseId       String?
  lastMessageAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  messages       Message[]

  @@unique([participantAId, participantBId])
  @@index([participantAId])
  @@index([participantBId])
  @@map("conversations")
}

model Message {
  id               String       @id @default(cuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId       String
  receiver         User         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  encryptedContent String
  iv               String
  senderPublicKey  String?
  isRead           Boolean      @default(false)
  createdAt        DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([receiverId, isRead])
  @@map("messages")
}

model TutorAvailability {
  id           String    @id @default(cuid())
  tutorId      String
  tutor        User      @relation("TutorAvailabilities", fields: [tutorId], references: [id], onDelete: Cascade)
  courseId     String?
  course       Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  dayOfWeek    Int?
  specificDate DateTime? @db.Timestamptz
  startTime    String
  endTime      String
  slotType     String    @default("ALL")
  timezone     String?   @default("Asia/Colombo")
  isRecurring  Boolean   @default(false)
  isActive     Boolean   @default(true)
  title        String?
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  @@index([tutorId])
  @@index([courseId])
  @@map("tutor_availabilities")
}

model StudentAvailability {
  id           String    @id @default(cuid())
  studentId    String
  student      User      @relation("StudentAvailabilities", fields: [studentId], references: [id], onDelete: Cascade)
  dayOfWeek    Int?
  specificDate DateTime? @db.Timestamptz
  startTime    String
  endTime      String
  timezone     String?   @default("Asia/Colombo")
  isRecurring  Boolean   @default(true)
  isActive     Boolean   @default(true)
  title        String?
  notes        String?
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  @@index([studentId])
  @@map("student_availabilities")
}
model SystemEvent {
  id        String   @id @default(cuid())
  type      String
  data      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("system_events")
}

model AuditLog {
  id          String   @id @default(cuid())
  adminId     String
  adminEmail  String
  action      String
  category    String   @default("GENERAL")
  targetId    String?
  targetLabel String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@index([action])
  @@index([category])
  @@map("audit_logs")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

model Payment {
  id            String        @id @default(cuid())
  checkoutId    String?       @unique
  reference     String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents   Int
  currency      String        @default("LKR")
  status        PaymentStatus @default(PENDING)
  itemType      String
  itemId        String
  itemTitle     String
  tokens        Int?
  checkoutUrl   String?
  paymentMethod String?
  rawWebhook    Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([reference])
  @@index([checkoutId])
  @@map("payments")
}

model AcademicSchool {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  subjectCodes String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("academic_schools")
}

model ClassAttendance {
  id              String           @id @default(cuid())
  eventId         String?
  event           Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  trialId         String?
  trial           TrialRequest?    @relation(fields: [trialId], references: [id], onDelete: Cascade)
  courseId        String?
  course          Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation("UserAttendance", fields: [userId], references: [id], onDelete: Cascade)
  userRole        Role             @default(STUDENT)
  status          AttendanceStatus @default(PRESENT)
  joinedAt        DateTime?        @db.Timestamptz
  leftAt          DateTime?        @db.Timestamptz
  durationMinutes Int?             @default(0)
  ipAddress       String?
  notes           String?
  markedBy        String?          @default("AUTO_ONLINE_JOIN")
  createdAt       DateTime         @default(now()) @db.Timestamptz
  updatedAt       DateTime         @updatedAt @db.Timestamptz

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId])
  @@index([trialId])
  @@index([trialId, userId])
  @@index([courseId])
  @@index([userRole])
  @@index([status])
  @@index([createdAt])
  @@map("class_attendance")
}

enum EnrollmentRequestStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  EXPIRED
}

model ClassEnrollmentRequest {
  id                      String                  @id @default(cuid())
  studentId               String
  student                 User                    @relation("StudentEnrollmentRequests", fields: [studentId], references: [id], onDelete: Cascade)
  tutorId                 String
  tutor                   User                    @relation("TutorEnrollmentRequests", fields: [tutorId], references: [id], onDelete: Cascade)
  courseId                String
  course                  Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  classType               String
  hoursPerWeek            Int                     @default(1)
  duration                String
  tokensInEscrow          Int                     @default(0)
  recurrenceDurationWeeks Int                     @default(4)
  selectedSlots           Json
  acceptedSlots           Json?
  status                  EnrollmentRequestStatus @default(PENDING)
  notes           String?
  rejectionReason String?
  events          Event[]
  createdAt       DateTime                @default(now()) @db.Timestamptz
  updatedAt       DateTime                @updatedAt @db.Timestamptz

  @@index([studentId])
  @@index([tutorId])
  @@index([courseId])
  @@index([status])
  @@map("class_enrollment_requests")
}

enum TokenGrantStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
}

model TokenGrant {
  id              String           @id @default(cuid())
  walletId        String
  wallet          TokenWallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation("UserTokenGrants", fields: [userId], references: [id], onDelete: Cascade)
  packageName     String
  tokensGranted   Float
  tokensRemaining Float
  costLkr         Float            @default(0)
  purchasedAt     DateTime         @default(now()) @db.Timestamptz
  expiresAt       DateTime         @db.Timestamptz
  status          TokenGrantStatus @default(ACTIVE)
  referenceId     String?
  createdAt       DateTime         @default(now()) @db.Timestamptz
  updatedAt       DateTime         @updatedAt @db.Timestamptz

  @@index([userId])
  @@index([walletId])
  @@index([status])
  @@index([expiresAt])
  @@map("token_grants")
}

model PayGradeSetting {
  id            String   @id @default("default_pay_grades")
  igcseRateLkr  Float    @default(750)
  ialRateLkr    Float    @default(850)
  tier1MinHours Float    @default(50)
  tier1BonusLkr Float    @default(5000)
  tier2MinHours Float    @default(75)
  tier2BonusLkr Float    @default(7500)
  tier3MinHours Float    @default(100)
  tier3BonusLkr Float    @default(10000)
  updatedAt     DateTime @updatedAt

  @@map("pay_grade_settings")
}

model TutorEarningRecord {
  id          String   @id @default(cuid())
  tutorId     String
  tutor       User     @relation("TutorEarnings", fields: [tutorId], references: [id], onDelete: Cascade)
  eventId     String?  @unique
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  studentId   String?
  student     User?    @relation("StudentClassEarnings", fields: [studentId], references: [id], onDelete: SetNull)
  tier        String   // "IGCSE" | "IAL_IAS"
  amountLkr   Float    // 750 or 850
  tokenCount  Float    @default(1)
  description String
  monthKey    String   // "2026-10"
  year        Int
  month       Int
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  @@index([tutorId])
  @@index([monthKey])
  @@index([createdAt])
  @@map("tutor_earnings_records")
}

model TutorMonthlyPayoutArchive {
  id             String   @id @default(cuid())
  tutorId        String
  tutor          User     @relation("TutorMonthlyPayouts", fields: [tutorId], references: [id], onDelete: Cascade)
  monthKey       String   // "2026-09", "2026-10"
  totalAmountLkr Float
  totalHours     Float
  igcseHours     Float    @default(0)
  ialHours       Float    @default(0)
  bonusAmountLkr Float    @default(0)
  bonusTier      String?
  status         String   @default("PAYABLE") // "PAYABLE", "PAID"
  closedAt       DateTime @default(now()) @db.Timestamptz

  @@unique([tutorId, monthKey])
  @@map("tutor_monthly_payout_archives")
}

enum RescheduleRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model ClassRescheduleRequest {
  id              String                  @id @default(cuid())
  eventId         String
  event           Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  courseId        String?
  course          Course?                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId       String
  student         User                    @relation("StudentRescheduleRequests", fields: [studentId], references: [id], onDelete: Cascade)
  tutorId         String
  tutor           User                    @relation("TutorRescheduleRequests", fields: [tutorId], references: [id], onDelete: Cascade)
  originalDate    DateTime                @db.Timestamptz
  requestedDate   DateTime                @db.Timestamptz
  studentReason   String?                 @db.Text
  tutorResponse   String?                 @db.Text
  status          RescheduleRequestStatus @default(PENDING)
  monthKey        String                  // "2026-10" to enforce max 2 per calendar month
  createdAt       DateTime                @default(now()) @db.Timestamptz
  updatedAt       DateTime                @updatedAt @db.Timestamptz

  @@index([studentId, monthKey])
  @@index([tutorId, status])
  @@index([eventId])
  @@map("class_reschedule_requests")
}
